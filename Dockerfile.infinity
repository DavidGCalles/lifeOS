FROM michaelf34/infinity:latest-cpu

# 1. Variables de entorno para forzar modo offline
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

WORKDIR /app

# 2. Copiamos los archivos a una ruta PLANA y NUEVA
# Esto evita que se cree /app/models/e5-small/e5-small por error
COPY ./models/e5-small /app/model_data

# 3. EL FIX: Permisos nucleares
# GSUtil descarga como root. Aquí le damos permiso de lectura a TODO EL MUNDO.
# Esto soluciona el "LocalEntryNotFoundError" provocado por "Permission Denied".
RUN chmod -R 777 /app/model_data

# 4. VERIFICACIÓN DE INTEGRIDAD (El "Detector de Mentiras")
# Esto obliga a transformers a cargar el modelo AHORA.
# Si falta un archivo o la config está mal, el build fallará aquí con el error real.
# 4. VERIFICACIÓN DE INTEGRIDAD (Corregido: Sin one-liner suicida)
RUN pip install transformers sentencepiece protobuf && \
    printf "import sys\n\
from transformers import AutoTokenizer, AutoModel\n\
path='/app/model_data'\n\
print(f'🐢 Testing load from {path}...')\n\
try:\n\
    tok = AutoTokenizer.from_pretrained(path)\n\
    print('✅ Tokenizer loaded')\n\
    model = AutoModel.from_pretrained(path)\n\
    print('✅ Model loaded')\n\
except Exception as e:\n\
    print(f'❌ CRASH: {e}')\n\
    sys.exit(1)\n" > check_model.py && \
    python3 check_model.py

# 4. Debugging visual (Opcional, para ver en logs si arranca)
#RUN ls -la /app/model_data

EXPOSE 8080

ENTRYPOINT ["infinity_emb"]

# 5. Apuntamos a la carpeta que ACABAMOS de crear y dar permisos
CMD ["--model-id", "/app/model_data", "--host", "0.0.0.0", "--port", "8080", "--engine", "torch"]