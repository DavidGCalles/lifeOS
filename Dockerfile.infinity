FROM michaelf34/infinity:latest-cpu

ENV HF_HOME=/tmp/huggingface
WORKDIR /app

RUN pip install --no-cache-dir huggingface_hub

RUN python3 -c "from huggingface_hub import snapshot_download; \
    print('🚀 Downloading model freshly from Hub...'); \
    snapshot_download( \
        repo_id='intfloat/multilingual-e5-small', \
        local_dir='/data/model', \
        local_dir_use_symlinks=False, \
        ignore_patterns=['*.msgpack', '*.h5', '*.ot'] \
    ); \
    print('✅ Download complete.')"

RUN rm -f /data/model/modules.json
RUN chmod -R 777 /data/model

ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

EXPOSE 8080

ENTRYPOINT ["infinity_emb"]
CMD ["--model-id", "/data/model", "--host", "0.0.0.0", "--port", "8080", "--engine", "torch"]