FROM michaelf34/infinity:latest-cpu

# Usamos la ruta completa y real
ENV MODEL_ID=/app/models/e5-small
ENV HF_HUB_OFFLINE=1

WORKDIR /app

# Esto ahora funcionará porque fetch-model habrá creado ./models/e5-small
COPY ./models/e5-small /app/models/e5-small

EXPOSE 8080

ENTRYPOINT ["infinity_emb"]
# CMD actualizado con la ruta interna correcta
CMD ["--model-id", "/app/models/e5-small", "--host", "0.0.0.0", "--port", "8080", "--engine", "torch", "--offline"]