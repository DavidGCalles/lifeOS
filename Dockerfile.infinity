FROM michaelf34/infinity:latest-cpu

# 1. Variables de entorno para modo offline estricto
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV HF_HOME=/tmp/huggingface

WORKDIR /app

# 2. Copiamos el modelo a una ruta segura y neutral
COPY ./models/e5-small /data/model

# 3. FIX CRÍTICO: Borramos modules.json para evitar que infinity intente conectarse a internet
# Esto fuerza el modo "arquitectura básica" (BERT puro) que sí funciona offline.
RUN rm -f /data/model/modules.json

# 4. Permisos de lectura para todos (para evitar líos de usuarios)
RUN chmod -R 777 /data/model

EXPOSE 8080

# 5. Arrancamos directo
ENTRYPOINT ["infinity_emb"]
CMD ["--model-id", "/data/model", "--host", "0.0.0.0", "--port", "8080", "--engine", "torch"]