# LifeOS v3 — edge
# El substrate (coreAI) lee sus variables de coreAI/.env (env_file del compose
# incluido, relativo a coreAI/). Tras scripts/bootstrap.sh:
#   cp coreAI/.envExample coreAI/.env
# y edita LOCAL_LLM_API_BASE (tu LLM local de la LAN) y los passwords.
#
# Este .env de la raiz es para variables de servicios PROPIOS del edge.

# --- edge-bot (v3-FR-02a) — cp .env.example .env ---
# Token de @BotFather (obligatorio: sin él el bot hace fail-fast al arrancar)
TELEGRAM_BOT_TOKEN=
# Identidad del usuario único de v1 (sustituye {current_user} en las personas)
LIFEOS_CURRENT_USER=David
# Opcional: whitelist de chat_ids 1:1 separados por coma (vacío = todos los 1:1)
ALLOWED_CHAT_ID=
# Opcional: timeout en segundos de las llamadas al LLM vía gateway
# (default 300: un LLM local puede tardar >120 s con recarga JIT tras idle)
LLM_TIMEOUT_S=300
